{
  "name": "dsh-glass-theme",
  "version": "1.0.2",
  "description": "柔光玻璃 (Soft Light Glass) theme plugin for DeepSeek Harness: frosted-glass UI, settings toggle, chat-area image/video wallpaper with volume control. DeepSeek Harness 玻璃主题插件。",
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh",
    "client.js",
    "soft-glass.css",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "theme",
    "glassmorphism",
    "soft-light-glass",
    "wallpaper",
    "ui"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cnayu/dsh-glass-theme.git"
  },
  "author": "cnayu",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}
